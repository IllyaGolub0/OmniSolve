# ============================================================================
# AI Exam & Screen Solver - Environment Configuration Template
# Copy this file to `.env` and fill in the API keys for the providers you use.
# You can also configure all keys and models directly inside the App Settings UI!
# ============================================================================

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API Key - Access 200+ models including free vision models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq Cloud API Key - Ultra-fast Llama 4 / Vision inference (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Custom OpenAI-Compatible API Key & Base URL (Optional)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:1234/v1

# Ollama Host (Local LLM - No API Key Required)
OLLAMA_BASE_URL=http://localhost:11434
